@page "/uczucie"
@rendermode InteractiveServer
@using Microsoft.Extensions.ML
@using System.Linq
@inject PredictionEnginePool<Feeling.ModelInput, Feeling.ModelOutput> PredictionPool


<PageTitle>Jak sie dzisiaj czujesz</PageTitle>

<h3>Jak sie dzisiaj czujesz</h3>

<p>
	<textarea class="form-control" placeholder="Opisz, jak się dzisiaj czujesz..." rows="4" @bind="userInput"></textarea>
</p>
<p>
	<button class="btn btn-primary" @onclick=AnalyzeSentiment>Analizuj nastroj</button>
</p>
@if (prediction != null)
{
	<div class="mt-3">
		<h3>Nastrój: <span class="text-success">@prediction.PredictedLabel</span></h3>
		<p class="text-muted">Pewność analizy: <strong>@(Math.Round(maxScore * 100, 2))%</strong></p>
	</div>
}





@code {
	private string userInput = "";
	private Feeling.ModelOutput? prediction;
	private float maxScore = 0.0f;
	private void AnalyzeSentiment()
	{
		if (!string.IsNullOrWhiteSpace(userInput))
		{
			var input = new Feeling.ModelInput { Text = userInput };
			prediction = PredictionPool.Predict(input);


			//najwyższe prawdopodobnieństwo z tablicy score
			if (prediction?.Score != null && prediction.Score.Length > 0)
			{
				maxScore = prediction.Score.Max();
			}
		}
	}

}
